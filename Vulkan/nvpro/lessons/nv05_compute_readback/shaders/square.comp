#version 450
// 本章计算阶段：核对线程组尺寸、资源寄存器/绑定、边界检查和写后读依赖。
layout(local_size_x = 64) in;
layout(binding = 0) buffer Values {
    uint values[];
};

// 每工作组 64 个线程；host dispatch 4 组，结果通过 storage buffer 读回。
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 256)
        values[i] = i * i + 1;
}
