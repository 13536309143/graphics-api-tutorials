{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "opengl-configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "opengl"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "opengl-debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "opengl-debug",
        "--parallel",
        "4"
      ],
      "dependsOn": "opengl-configure",
      "problemMatcher": [
        "$msCompile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
