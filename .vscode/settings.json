{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [
    100
  ],
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "C_Cpp.clang_format_style": "file",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "*.vert": "glsl",
    "*.frag": "glsl",
    "*.geom": "glsl",
    "*.comp": "glsl"
  }
}
